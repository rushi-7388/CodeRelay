## Backend environment (example)
## Copy to `backend/.env` and fill in real values.

# App
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Public config (safe for browsers — served via GET /api/config/public)
# CLERK_PUBLISHABLE_KEY=pk_test_...
# PUBLIC_API_URL=http://localhost:5000/api

# Database (MongoDB)
DB_URL=mongodb://127.0.0.1:27017/coderelay

# Clerk (webhooks)
# CLERK_WEBHOOK_SECRET=whsec_...

# Inngest (optional)
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Stream (video/chat)
# STREAM_API_KEY=
# STREAM_API_SECRET=

# Stripe (billing)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# GitHub OAuth (optional, if used)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# AI Provider configuration
# Recommended: Anthropic (set in a later TODO)
# AI_PROVIDER=anthropic
# AI_API_KEY=             # legacy / generic key (avoid; prefer provider-specific keys)
# OPENAI_API_KEY=         # if AI_PROVIDER=openai
# ANTHROPIC_API_KEY=      # if AI_PROVIDER=anthropic
# AI_CUSTOM_ENDPOINT=     # if AI_PROVIDER=custom (full base URL)
# AI_MODEL=               # optional model override (provider-specific)
