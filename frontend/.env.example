## Frontend environment (example)
## Copy to `frontend/.env` and fill in real values.

# Clerk
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend API base URL (include /api)
VITE_API_URL=http://localhost:5000/api

# Optional: comma-separated API pool for Relay Balance™ (latency-based routing)
# VITE_API_URLS=http://localhost:5000/api,http://localhost:8080/api
